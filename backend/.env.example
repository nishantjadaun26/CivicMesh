# CivicMesh Backend Configuration Example
# Do not commit real credentials or keys to Git.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=30

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Connection (PostgreSQL with PostGIS extension)
# e.g., postgresql+asyncpg://postgres:password@localhost:5432/civicmesh
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/civicmesh

# Supabase Auth
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Service role key is WORKER/BACKEND ONLY. NEVER expose to frontend.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Storage Buckets
STORAGE_EVIDENCE_BUCKET=civicmesh-evidence
STORAGE_DOCUMENTS_BUCKET=civicmesh-sources

# Pilot Locality
PILOT_LOCALITY_NAME=Pilot-Ward-1
PILOT_LATITUDE=28.6139
PILOT_LONGITUDE=77.2090
PILOT_RADIUS_METERS=5000

# AI Provider (Worker-only)
GEMINI_API_KEY=your-worker-only-gemini-key
GEMINI_MODEL=gemini-2.5-flash
