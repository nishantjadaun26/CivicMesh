# Copy to repository-root .env for local API/worker commands. Never commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=30
WRITE_REQUESTS_PER_HOUR=60
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DATABASE_URL=postgresql+asyncpg://postgres:replace-me@localhost:5432/civicmesh
# Optional provider CA certificate/bundle mounted on API and worker hosts.
DATABASE_SSL_ROOT_CERT=
SUPABASE_URL=https://your-project.supabase.co
# Leave blank for ES256/RS256 project JWKS. Set only for legacy HS256 signing.
SUPABASE_JWT_SECRET=
# Server-only service_role JWT. Never use a browser/public key here.
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_EVIDENCE_BUCKET=civicmesh-evidence
# Real owner-confirmed locality and center; no invented pilot defaults.
PILOT_LOCALITY_NAME=
# PILOT_LATITUDE=
# PILOT_LONGITUDE=
PILOT_RADIUS_METERS=5000
# Worker-only model configuration. No default model or automatic paid verification.
GEMINI_API_KEY=
GEMINI_MODEL=
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_MAX_RETRIES=3
WORKER_JOB_TIMEOUT_SECONDS=300
WORKER_LEASE_SECONDS=600
# Worker-only psycopg PostgreSQL DSN. Direct or session connection, never transaction pooling.
# Required for production; same logical database as DATABASE_URL, sslmode=verify-full.
CHECKPOINT_DATABASE_URL=
# Used only in non-production if the PostgreSQL checkpoint DSN is empty.
LOCAL_CHECKPOINT_PATH=.cache/checkpoints.sqlite
