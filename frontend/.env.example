# CivicMesh Frontend Environment Variables
# Copy to .env.local or .env for local development

# Backend API endpoint
VITE_API_URL=http://127.0.0.1:8000/api

# Supabase Auth Configuration (Client-side Public Anonymous Key only)
# IMPORTANT: Never put your Supabase service-role key here!
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Map Tile Provider URL (default: OpenStreetMap)
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
