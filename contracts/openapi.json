  "components": {
    "schemas": {
      "ClarificationAnswerRequest": {
        "properties": {
          "checkpoint_id": {
            "type": "string",
            "minLength": 1,
            "title": "Checkpoint Id"
          },
          "interrupt_id": {
            "type": "string",
            "minLength": 1,
            "title": "Interrupt Id"
          },
          "text": {
            "type": "string",
            "maxLength": 4000,
            "title": "Text",
            "default": ""
          },
          "category": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "garbage",
                  "water_leak"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "location": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ConfirmedLocation"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "checkpoint_id",
          "interrupt_id"
        ],
        "title": "ClarificationAnswerRequest",
        "description": "Citizen answer to a workflow clarification request."
      },
      "ConfirmedLocation": {
        "properties": {
          "latitude": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude",
            "description": "WGS84 latitude"
          },
          "longitude": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude",
            "description": "WGS84 longitude"
          },
          "confirmed": {
            "type": "boolean",
            "const": true,
            "title": "Confirmed",
            "description": "Explicit manual confirmation flag"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "latitude",
          "longitude",
          "confirmed"
        ],
        "title": "ConfirmedLocation",
        "description": "Explicit coordinate values confirmed by citizen."
      },
      "FollowUpCreateRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 10000,
            "title": "Text",
            "default": ""
          },
          "evidence_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 1,
            "title": "Evidence Ids"
          },
          "same_location_confirmed": {
            "type": "boolean",
            "title": "Same Location Confirmed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "same_location_confirmed"
        ],
        "title": "FollowUpCreateRequest",
        "description": "Citizen submission of follow-up observations and evidence."
      },
      "FollowUpResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "incident_id": {
            "type": "string",
            "format": "uuid",
            "title": "Incident Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "incident_id",
          "status",
          "created_at"
        ],
        "title": "FollowUpResponse"
      },
      "IncidentDetailResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "category": {
            "type": "string",
            "enum": [
              "garbage",
              "water_leak"
            ],
            "title": "Category"
          },
          "latitude": {
            "type": "number",
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "title": "Longitude"
          },
          "observed_condition": {
            "type": "string",
            "title": "Observed Condition",
            "description": "Citizen-observed condition or AI assessment"
          },
          "authority_status": {
            "type": "string",
            "title": "Authority Status",
            "description": "Verified official authority response only",
            "default": "unknown"
          },
          "is_public": {
            "type": "boolean",
            "title": "Is Public",
            "default": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "timeline": {
            "items": {
              "$ref": "#/components/schemas/StatusEventResponse"
            },
            "type": "array",
            "title": "Timeline"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "category",
          "latitude",
          "longitude",
          "observed_condition",
          "created_at",
          "updated_at"
        ],
        "title": "IncidentDetailResponse",
        "description": "Public incident detail with verified timeline events."
      },
      "IncidentPublicResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "category": {
            "type": "string",
            "enum": [
              "garbage",
              "water_leak"
            ],
            "title": "Category"
          },
          "latitude": {
            "type": "number",
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "title": "Longitude"
          },
          "observed_condition": {
            "type": "string",
            "title": "Observed Condition",
            "description": "Citizen-observed condition or AI assessment"
          },
          "authority_status": {
            "type": "string",
            "title": "Authority Status",
            "description": "Verified official authority response only",
            "default": "unknown"
          },
          "is_public": {
            "type": "boolean",
            "title": "Is Public",
            "default": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "category",
          "latitude",
          "longitude",
          "observed_condition",
          "created_at",
          "updated_at"
        ],
        "title": "IncidentPublicResponse",
        "description": "Approved public incident projection. Omits private citizen details."
      },
      "JobResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "format": "uuid",
            "title": "Job Id"
          },
          "report_id": {
            "type": "string",
            "format": "uuid",
            "title": "Report Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "waiting_for_input",
              "completed",
              "failed"
            ],
            "title": "Status"
          },
          "attempts": {
            "type": "integer",
            "title": "Attempts",
            "default": 0
          },
          "max_attempts": {
            "type": "integer",
            "title": "Max Attempts",
            "default": 3
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
